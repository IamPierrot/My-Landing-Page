---
interface Props {
	title?: string;
	class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class:list={['sidebar-section flex flex-col gap-2.5', className]}>
	{
		title && (
			<div class="flex items-center justify-between pb-2 border-b border-[#243752]/60">
				<span class="font-mono text-xs uppercase tracking-wider text-[#546C8E] font-semibold flex items-center gap-1.5">
					<span class="text-[#38BDF8] font-bold">//</span>
					<span>{title}</span>
				</span>
				<slot name="badge" />
			</div>
		)
	}
	<slot />
</div>
