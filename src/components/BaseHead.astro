---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

export interface ArticleMeta {
	publishedTime: Date;
	modifiedTime?: Date;
	author?: string;
	section?: string;
	tags?: string[];
}

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	type?: 'website' | 'article' | 'profile';
	noindex?: boolean;
	article?: ArticleMeta;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	image = '/og/default.png',
	imageAlt = `${AUTHOR.name} — ${SITE_TITLE}`,
	imageWidth: customWidth,
	imageHeight: customHeight,
	type = 'website',
	noindex = false,
	article,
	schema,
} = Astro.props;

const siteBase = Astro.site ?? new URL(SITE_URL);
const canonicalURL = new URL(Astro.url.pathname, siteBase);

const resolvedImagePath = typeof image === 'string' ? image : image.src;
const resolvedImageURL = new URL(resolvedImagePath, siteBase);

const resolvedWidth =
	customWidth ?? (typeof image === 'string' ? 1200 : image.width || 1200);
const resolvedHeight =
	customHeight ?? (typeof image === 'string' ? 630 : image.height || 630);

const resolvedImageType =
	typeof image === 'string'
		? resolvedImagePath.endsWith('.jpg') || resolvedImagePath.endsWith('.jpeg')
			? 'image/jpeg'
			: resolvedImagePath.endsWith('.webp')
				? 'image/webp'
				: 'image/png'
		: image.format === 'jpg'
			? 'image/jpeg'
			: `image/${image.format}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', siteBase)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Indexing & Crawler Directives -->
<meta
	name="robots"
	content={noindex
		? 'noindex, nofollow'
		: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<!-- Fonts: Plus Jakarta Sans & JetBrains Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
	rel="stylesheet"
/>

<!-- Canonical URL -->
{!noindex && <link rel="canonical" href={canonicalURL.href} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#38BDF8" />

<!-- Immediate Navigation Preference Hydration & Preloader Anti-Flash -->
<script is:inline>
	(function () {
		try {
			const saved = localStorage.getItem('pierrot_nav_style') || 'soc';
			document.documentElement.setAttribute('data-nav-style', saved);
		} catch (e) {
			document.documentElement.setAttribute('data-nav-style', 'soc');
		}

		try {
			if (
				sessionStorage.getItem('pierrot_preloader_seen') === 'true' ||
				window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				document.documentElement.classList.add('preloader-skipped');
			}
		} catch (e) {}
	})();
</script>

<!-- Open Graph / Discord / Facebook Messenger -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImageURL.href} />
<meta property="og:image:secure_url" content={resolvedImageURL.href} />
<meta property="og:image:type" content={resolvedImageType} />
<meta property="og:image:width" content={String(resolvedWidth)} />
<meta property="og:image:height" content={String(resolvedHeight)} />
<meta property="og:image:alt" content={imageAlt} />

{
	type === 'article' && article && (
		<>
			<meta property="article:published_time" content={article.publishedTime.toISOString()} />
			{article.modifiedTime && (
				<meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
			)}
			<meta property="article:author" content={article.author || AUTHOR.name} />
			{article.section && <meta property="article:section" content={article.section} />}
			{article.tags?.map((tag) => (
				<meta property="article:tag" content={tag} />
			))}
		</>
	)
}

<!-- X (Twitter) Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImageURL.href} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Structured Data (JSON-LD) -->
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
