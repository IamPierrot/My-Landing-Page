---
import { Shield, Github, Mail, Terminal } from 'lucide-astro';
import NavigationSwitcher from './NavigationSwitcher.astro';
import { navigationItems } from './navigation.config';
import { GITHUB_URL, HACKTHEBOX_URL } from '../../consts';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
---

<nav
	class="nav-soc autohide-nav hidden md:block sticky top-0 z-50 w-full border-b border-[#243752] bg-[#101A2B]/95 backdrop-blur-md transition-colors"
	aria-label="SOC Status Navigation"
>
	<div class="max-w-5xl mx-auto px-6 sm:px-8 py-3.5 flex items-center justify-between gap-6">
		<!-- Left: Identity -->
		<div class="flex items-center gap-3">
			<a
				href="/"
				class="group flex items-center gap-2.5 text-[#DCE8F5] hover:text-[#38BDF8] transition-colors"
				aria-label="Pierrot Homepage"
			>
				<div
					class="w-9 h-9 rounded-lg bg-[#16233B] border border-[#243752] flex items-center justify-center text-[#38BDF8] group-hover:border-[#38BDF8]/40 group-hover:shadow-[0_0_12px_rgba(56,189,248,0.25)] transition-all"
				>
					<Shield class="w-5 h-5" />
				</div>
				<div class="flex flex-col">
					<span
						class="font-mono font-extrabold text-sm sm:text-base leading-none text-[#DCE8F5] group-hover:text-[#38BDF8] tracking-widest"
					>
						PIERROT
					</span>
					<span class="font-mono text-[11px] text-[#546C8E] font-medium tracking-wide mt-0.5">
						SEC_ENGINEERING
					</span>
				</div>
			</a>
		</div>

		<!-- Center: Route Links (Bigger Scale & Spacing) -->
		<div class="flex items-center gap-1.5 sm:gap-2">
			{
				navigationItems.map((item) => {
					const isActive = item.href === pathname || item.href === '/' + (subpath?.[0] || '');
					return (
						<a
							href={item.href}
							aria-current={isActive ? 'page' : undefined}
							class:list={[
								'px-4 py-2 rounded-md font-mono text-xs sm:text-sm uppercase tracking-wider transition-all duration-150',
								isActive
									? 'text-[#38BDF8] bg-[#38BDF8]/15 border border-[#38BDF8]/35 font-bold shadow-[0_0_12px_rgba(56,189,248,0.18)]'
									: 'text-[#8FA6C2] hover:text-[#DCE8F5] hover:bg-[#16233B] border border-transparent font-medium',
							]}
						>
							{item.label}
						</a>
					);
				})
			}
		</div>

		<!-- Right: Status & Actions -->
		<div class="flex items-center gap-3 font-mono text-xs">
			<!-- Telemetry Chip -->
			<div
				class="hidden lg:inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-[#080D18] border border-[#243752] text-[#8FA6C2] text-xs font-semibold"
			>
				<span class="relative flex h-2 w-2">
					<span
						class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#38BDF8] opacity-75"
					></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-[#38BDF8]"></span>
				</span>
				<span>ONLINE</span>
			</div>

			<!-- GitHub Icon -->
			<a
				href={GITHUB_URL}
				target="_blank"
				rel="noreferrer noopener"
				class="inline-flex items-center justify-center w-9 h-9 rounded-md text-[#8FA6C2] hover:text-[#38BDF8] hover:bg-[#16233B] border border-transparent hover:border-[#243752] transition-colors"
				aria-label="GitHub Profile"
				title="GitHub Profile"
			>
				<Github class="w-4 h-4" />
			</a>

			<!-- HackTheBox Icon -->
			<a
				href={HACKTHEBOX_URL}
				target="_blank"
				rel="noreferrer noopener"
				class="inline-flex items-center justify-center w-9 h-9 rounded-md text-[#8FA6C2] hover:text-[#38BDF8] hover:bg-[#16233B] border border-transparent hover:border-[#243752] transition-colors"
				aria-label="HackTheBox Profile (IamPierrot)"
				title="IamPierrot HTB Profile"
			>
				<Terminal class="w-4 h-4" />
			</a>

			<!-- Contact CTA -->
			<a
				href="mailto:phatnguyentan836@gmail.com"
				class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-[#16233B] hover:bg-[#16233B]/80 text-[#DCE8F5] hover:text-[#38BDF8] border border-[#243752] hover:border-[#38BDF8]/40 transition-colors text-xs font-bold shadow-sm"
			>
				<Mail class="w-3.5 h-3.5 text-[#38BDF8]" />
				<span>CONTACT</span>
			</a>

			<!-- Mode Switcher -->
			<NavigationSwitcher variant="compact" />
		</div>
	</div>
</nav>
