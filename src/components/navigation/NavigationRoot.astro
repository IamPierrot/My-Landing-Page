---
import FloatingDock from './FloatingDock.astro';
import SOCNavigation from './SOCNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
import Preloader from '../preloader/Preloader.astro';
---

<!-- Compulsory Initial Visit Preloader -->
<Preloader />

<!-- Desktop: SOC Status Navigation -->
<SOCNavigation />

<!-- Desktop: Floating Dock Navigation -->
<FloatingDock />

<!-- Mobile: Shared Adaptive Drawer (< 768px) -->
<MobileNavigation />

<script>
	import { initNavigationAutohide } from '../../scripts/navigation-autohide';

	initNavigationAutohide();
</script>

<style is:global>
	/* Desktop Navigation Toggle Controls */
	@media (min-width: 768px) {
		/* When style is soc (or default before JS runs) */
		html:not([data-nav-style='floating']) .nav-floating {
			display: none !important;
		}

		html:not([data-nav-style='floating']) .nav-soc {
			display: block !important;
		}

		/* When style is floating dock */
		html[data-nav-style='floating'] .nav-soc {
			display: none !important;
		}

		html[data-nav-style='floating'] .nav-floating {
			display: flex !important;
		}
	}

	/* Autohide & Smooth Sticky Navigation */
	.autohide-nav {
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, box-shadow 0.25s ease !important;
		will-change: transform;
	}

	/* Hidden state: slides up smoothly when user scrolls down */
	.nav-soc.autohide-nav.nav-hidden {
		transform: translateY(-100%) !important;
	}

	.nav-floating.autohide-nav.nav-hidden {
		transform: translateY(calc(-100% - 3.5rem)) !important;
		opacity: 0 !important;
		pointer-events: none !important;
	}

	header.autohide-nav.nav-hidden {
		transform: translateY(-100%) !important;
	}

	/* Elevated subtle shadow when scrolled / stuck */
	.nav-soc.autohide-nav.nav-stuck {
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
	}

	header.autohide-nav.nav-stuck {
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
	}
</style>
