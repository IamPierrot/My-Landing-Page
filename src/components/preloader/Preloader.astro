---
---

<div
	id="site-preloader"
	class="fixed inset-0 z-[9999] bg-[#080D18] border-b border-[#243752]/70 shadow-[0_25px_60px_rgba(0,0,0,0.95)] will-change-transform flex flex-col items-center justify-center p-4 sm:p-6 select-none overflow-hidden"
	aria-live="polite"
	aria-label="System Initializing"
>
	<!-- Ambient Background Glow -->
	<div
		class="absolute w-[360px] h-[360px] rounded-full bg-[#38BDF8]/5 blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>

	<!-- Terminal Card -->
	<div
		class="boot-card relative w-full max-w-lg bg-[#101A2B] border border-[#243752] rounded-xl p-5 sm:p-7 shadow-[0_0_50px_rgba(0,0,0,0.85)] overflow-hidden font-mono text-xs sm:text-sm text-[#DCE8F5]"
	>
		<!-- Cyan Top Accent Line -->
		<div
			class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#38BDF8] to-transparent"
		>
		</div>

		<!-- Terminal Window Header -->
		<div class="flex items-center justify-between pb-4 border-b border-[#243752] mb-5 text-xs text-[#8FA6C2]">
			<div class="flex items-center gap-2">
				<span class="w-2.5 h-2.5 rounded-full bg-[#F43F5E]/80"></span>
				<span class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]/80"></span>
				<span class="w-2.5 h-2.5 rounded-full bg-[#38BDF8]/80"></span>
				<span class="ml-2 font-semibold text-[#DCE8F5] tracking-wide">PIERROT_SEC</span>
			</div>
			<div class="text-[11px] text-[#546C8E] flex items-center gap-1.5">
				<span class="inline-block w-1.5 h-1.5 rounded-full bg-[#38BDF8] animate-pulse"></span>
				<span>BOOT_SEQ</span>
			</div>
		</div>

		<!-- Boot Sequence Content -->
		<div class="space-y-2.5 mb-6">
			<!-- Prompt command line -->
			<div class="boot-prompt flex items-center gap-2 text-xs sm:text-sm">
				<span class="text-[#38BDF8] font-bold">pierrot@soc-lab:~$</span>
				<span class="text-[#DCE8F5]">systemctl start portfolio</span>
			</div>

			<!-- Status Messages Sequence -->
			<div class="space-y-1.5 pt-2 text-[11px] sm:text-xs text-[#8FA6C2]">
				<div class="boot-line flex items-center gap-2">
					<span class="text-[#38BDF8] font-bold">[ OK ]</span>
					<span>Loading security modules</span>
				</div>
				<div class="boot-line flex items-center gap-2">
					<span class="text-[#38BDF8] font-bold">[ OK ]</span>
					<span>Initializing network stack</span>
				</div>
				<div class="boot-line flex items-center gap-2">
					<span class="text-[#38BDF8] font-bold">[ OK ]</span>
					<span>Mounting project filesystem</span>
				</div>
				<div class="boot-line flex items-center gap-2">
					<span class="text-[#38BDF8] font-bold">[ OK ]</span>
					<span>Loading research archives</span>
				</div>
				<div class="boot-line flex items-center gap-2">
					<span class="text-[#38BDF8] font-bold">[ OK ]</span>
					<span>Initializing interface</span>
				</div>
			</div>
		</div>

		<!-- Progress Indicator -->
		<div class="pt-3 border-t border-[#243752]/60 mb-5">
			<div class="flex items-center justify-between text-[11px] text-[#8FA6C2] mb-1.5 font-mono">
				<span class="text-[#546C8E]">SYS_KERNEL_LOAD</span>
				<span class="boot-progress-text text-[#38BDF8] font-bold">0%</span>
			</div>
			<div class="w-full h-1.5 bg-[#080D18] rounded-full overflow-hidden border border-[#243752]">
				<div
					class="boot-progress-fill h-full bg-gradient-to-r from-[#0284C7] to-[#38BDF8] rounded-full shadow-[0_0_10px_rgba(56,189,248,0.5)]"
					style="width: 0%;"
				>
				</div>
			</div>
		</div>

		<!-- System Ready Line -->
		<div class="boot-ready flex items-center justify-between text-xs font-bold text-[#38BDF8] pt-1">
			<div class="flex items-center gap-1.5">
				<span>&gt; SYSTEM READY.</span>
				<span class="animate-pulse">_</span>
			</div>
			<span class="text-[10px] text-[#546C8E] font-normal font-mono">[ESC to skip]</span>
		</div>
	</div>
</div>

<script>
	import { runPreloader } from './preloader';

	const el = document.getElementById('site-preloader');
	if (el) {
		runPreloader(el);
	}
</script>
