---
import { getCollection } from 'astro:content';
import {
	Search,
	Filter,
	Calendar,
	Clock,
	ArrowRight,
	RotateCcw,
	BookOpen,
} from 'lucide-astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allCategories = Array.from(new Set(posts.map((p) => p.data.category)));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog // ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#080D18] text-[#DCE8F5] antialiased selection:bg-[#38BDF8]/20 selection:text-[#38BDF8]">
		<Header />
		<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
			<!-- Page Header -->
			<section class="pb-8 border-b border-[#243752] mb-8">
				<div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-[#8FA6C2] mb-3">
					<span class="text-[#38BDF8] font-bold">//</span>
					<span>Research &amp; Technical Notes</span>
				</div>

				<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#F0F6FC] mb-3">
					Technical Journal
				</h1>

				<p class="text-base text-[#8FA6C2] max-w-2xl leading-relaxed mb-6 font-normal">
					Documentation, protocol dissections, incident response walkthroughs, and experiments in network forensics, memory triage, and system programming.
				</p>

				<!-- Search & Filter Controls -->
				<div class="flex flex-col gap-4">
					<!-- Search Box -->
					<div class="relative w-full">
						<Search class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#546C8E] pointer-events-none" />
						<input
							type="text"
							id="blog-search-input"
							placeholder="Search by topic, keyword, protocol, or tag (e.g., DNS, tshark, SMB)..."
							class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-[#101A2B] border border-[#243752] text-sm text-[#DCE8F5] placeholder-[#546C8E] focus:outline-none focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8] transition-all font-sans"
						/>
					</div>

					<!-- Categories Filter Bar -->
					<div class="flex items-center flex-wrap gap-2 text-xs font-mono">
						<span class="text-[#546C8E] mr-1 flex items-center gap-1">
							<Filter class="w-3.5 h-3.5 text-[#38BDF8]" /> Categories:
						</span>

						<button
							type="button"
							class="category-filter-btn active px-3 py-1.5 rounded-md text-xs font-medium transition-all cursor-pointer bg-[#38BDF8]/15 text-[#38BDF8] border border-[#38BDF8]/40"
							data-category="all"
						>
							All ({posts.length})
						</button>

						{allCategories.map((cat) => {
							const count = posts.filter((p) => p.data.category === cat).length;
							return (
								<button
									type="button"
									class="category-filter-btn px-3 py-1.5 rounded-md text-xs font-medium transition-all cursor-pointer bg-[#101A2B] text-[#8FA6C2] border border-[#243752] hover:bg-[#16233B] hover:text-[#DCE8F5] hover:border-[#38BDF8]/30"
									data-category={cat}
								>
									{cat} ({count})
								</button>
							);
						})}

						<button
							type="button"
							id="reset-blog-filter"
							class="hidden items-center gap-1 px-2.5 py-1.5 rounded-md text-xs font-mono text-[#546C8E] hover:text-[#38BDF8] hover:bg-[#101A2B] transition-colors ml-auto cursor-pointer"
						>
							<RotateCcw class="w-3 h-3" />
							<span>Reset</span>
						</button>
					</div>
				</div>
			</section>

			<!-- Articles Section -->
			<section aria-label="Articles list">
				<!-- Meta status bar -->
				<div class="flex items-center justify-between pb-3 border-b border-[#243752]/60 mb-6 font-mono text-xs text-[#546C8E]">
					<span>
						INDEXED_DOCS: <strong class="text-[#38BDF8]" id="visible-post-count">{posts.length}</strong> / {posts.length}
					</span>
					<span>ORDER: DATE_DESC</span>
				</div>

				<!-- Articles Grid / List -->
				<div class="flex flex-col gap-6" id="blog-posts-list">
					{posts.map((post) => (
						<article
							class="blog-post-card group bg-[#101A2B] border border-[#243752] rounded-xl p-6 sm:p-7 transition-all duration-200 hover:-translate-y-1 hover:border-[#38BDF8]/50 hover:bg-[#142035] hover:shadow-[0_8px_30px_rgba(56,189,248,0.08)] flex flex-col gap-3.5"
							data-category={post.data.category}
							data-tags={post.data.tags.join(',')}
							data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
						>
							<!-- Top Metadata Row -->
							<div class="flex items-center flex-wrap gap-2.5 text-xs font-mono text-[#8FA6C2]">
								<span class="px-2.5 py-0.5 rounded-full bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30 font-semibold tracking-wide text-[11px] uppercase">
									{post.data.category}
								</span>
								<span class="text-[#243752]">&bull;</span>
								<span class="inline-flex items-center gap-1.5 text-[#8FA6C2]">
									<Calendar class="w-3.5 h-3.5 text-[#38BDF8]" />
									<FormattedDate date={post.data.pubDate} />
								</span>
								{post.data.readingTime && (
									<>
										<span class="text-[#243752]">&bull;</span>
										<span class="inline-flex items-center gap-1.5 text-[#546C8E]">
											<Clock class="w-3.5 h-3.5 text-[#546C8E]" />
											{post.data.readingTime}
										</span>
									</>
								)}
							</div>

							<!-- Headline -->
							<h2 class="text-xl sm:text-2xl font-bold text-[#F0F6FC] leading-snug group-hover:text-[#38BDF8] transition-colors">
								<a href={`/blog/${post.id}/`} class="hover:underline focus:outline-none">
									{post.data.title}
								</a>
							</h2>

							<!-- Excerpt / Summary -->
							<p class="text-sm sm:text-base text-[#8FA6C2] leading-relaxed line-clamp-3">
								{post.data.description}
							</p>

							<!-- Card Footer: Tags & Read CTA -->
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3.5 border-t border-[#243752]/50 mt-1">
								<div class="flex items-center flex-wrap gap-1.5">
									{post.data.tags.map((tag) => (
										<span class="font-mono text-xs px-2 py-0.5 rounded bg-[#080D18] text-[#546C8E] border border-[#243752]/80 group-hover:border-[#38BDF8]/30 group-hover:text-[#8FA6C2] transition-colors">
											#{tag}
										</span>
									))}
								</div>

								<a
									href={`/blog/${post.id}/`}
									class="inline-flex items-center gap-1.5 font-mono text-xs text-[#38BDF8] group-hover:text-[#7DD3FC] font-medium transition-all group-hover:translate-x-0.5"
								>
									<span>Read article</span>
									<ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
								</a>
							</div>
						</article>
					))}
				</div>

				<!-- Empty Search State -->
				<div
					id="no-posts-found"
					class="hidden flex-col items-center justify-center p-10 bg-[#101A2B]/60 border border-[#243752] rounded-xl text-center my-8"
				>
					<BookOpen class="w-10 h-10 text-[#546C8E] mb-3" />
					<h3 class="font-mono text-base font-semibold text-[#DCE8F5] mb-1">
						NO_DOCUMENTS_FOUND
					</h3>
					<p class="text-sm text-[#8FA6C2] max-w-sm mb-4">
						No technical articles matched your search or category filter.
					</p>
					<button
						type="button"
						id="empty-reset-btn"
						class="inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1.5 rounded-md bg-[#16233B] text-[#38BDF8] border border-[#38BDF8]/40 hover:bg-[#38BDF8]/10 transition-colors cursor-pointer"
					>
						<RotateCcw class="w-3 h-3" />
						<span>Reset filters</span>
					</button>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Interactive Filter Script -->
		<script>
			function initBlogFiltering() {
				const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
				const categoryButtons = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
				const resetButton = document.getElementById('reset-blog-filter') as HTMLButtonElement | null;
				const emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement | null;
				const cards = document.querySelectorAll<HTMLElement>('.blog-post-card');
				const countEl = document.getElementById('visible-post-count');
				const noPostsEl = document.getElementById('no-posts-found');

				if (!cards.length) return;

				let activeCategory = 'all';
				let searchQuery = '';

				function updateVisibility() {
					let visibleCount = 0;

					cards.forEach((card) => {
						const cardCategory = card.getAttribute('data-category') || '';
						const cardSearchData = card.getAttribute('data-search') || '';

						const matchesCategory =
							activeCategory === 'all' ||
							cardCategory.toLowerCase() === activeCategory.toLowerCase();

						const matchesSearch =
							!searchQuery || cardSearchData.includes(searchQuery.toLowerCase());

						if (matchesCategory && matchesSearch) {
							card.style.display = 'flex';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					if (countEl) {
						countEl.textContent = String(visibleCount);
					}

					if (noPostsEl) {
						if (visibleCount === 0) {
							noPostsEl.classList.remove('hidden');
							noPostsEl.classList.add('flex');
						} else {
							noPostsEl.classList.add('hidden');
							noPostsEl.classList.remove('flex');
						}
					}

					if (resetButton) {
						if (activeCategory !== 'all' || searchQuery.length > 0) {
							resetButton.classList.remove('hidden');
							resetButton.classList.add('inline-flex');
						} else {
							resetButton.classList.add('hidden');
							resetButton.classList.remove('inline-flex');
						}
					}
				}

				// Category button click handler
				categoryButtons.forEach((btn) => {
					btn.addEventListener('click', () => {
						categoryButtons.forEach((b) => {
							b.classList.remove('active', 'bg-[#38BDF8]/15', 'text-[#38BDF8]', 'border-[#38BDF8]/40');
							b.classList.add('bg-[#101A2B]', 'text-[#8FA6C2]', 'border-[#243752]');
						});

						btn.classList.add('active', 'bg-[#38BDF8]/15', 'text-[#38BDF8]', 'border-[#38BDF8]/40');
						btn.classList.remove('bg-[#101A2B]', 'text-[#8FA6C2]', 'border-[#243752]');

						activeCategory = btn.getAttribute('data-category') || 'all';
						updateVisibility();
					});
				});

				// Search input handler
				if (searchInput) {
					searchInput.addEventListener('input', (e) => {
						searchQuery = (e.target as HTMLInputElement).value.trim();
						updateVisibility();
					});
				}

				// Reset handlers
				const resetAll = () => {
					activeCategory = 'all';
					searchQuery = '';
					if (searchInput) searchInput.value = '';

					categoryButtons.forEach((b) => {
						if (b.getAttribute('data-category') === 'all') {
							b.classList.add('active', 'bg-[#38BDF8]/15', 'text-[#38BDF8]', 'border-[#38BDF8]/40');
							b.classList.remove('bg-[#101A2B]', 'text-[#8FA6C2]', 'border-[#243752]');
						} else {
							b.classList.remove('active', 'bg-[#38BDF8]/15', 'text-[#38BDF8]', 'border-[#38BDF8]/40');
							b.classList.add('bg-[#101A2B]', 'text-[#8FA6C2]', 'border-[#243752]');
						}
					});

					updateVisibility();
				};

				if (resetButton) resetButton.addEventListener('click', resetAll);
				if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initBlogFiltering);
			} else {
				initBlogFiltering();
			}
			document.addEventListener('astro:page-load', initBlogFiltering);
		</script>
	</body>
</html>
