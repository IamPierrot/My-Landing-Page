---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return posts.map((post) => {
		const postTags = new Set(post.data.tags.map((t) => t.toLowerCase()));
		const relatedPosts = posts
			.filter((other) => other.id !== post.id)
			.map((other) => {
				const sharedTags = other.data.tags.filter((t) => postTags.has(t.toLowerCase())).length;
				const sameCategory = other.data.category === post.data.category ? 2 : 0;
				return { other, score: sharedTags + sameCategory };
			})
			.sort((a, b) => b.score - a.score || b.other.data.pubDate.valueOf() - a.other.data.pubDate.valueOf())
			.slice(0, 2)
			.map(({ other }) => ({
				id: other.id,
				title: other.data.title,
				description: other.data.description,
				category: other.data.category,
				pubDate: other.data.pubDate,
				readingTime: other.data.readingTime,
			}));

		return {
			params: { slug: post.id },
			props: { post, relatedPosts },
		};
	});
}

interface RelatedPostSummary {
	id: string;
	title: string;
	description: string;
	category: string;
	pubDate: Date;
	readingTime?: string;
}

interface Props {
	post: CollectionEntry<'blog'>;
	relatedPosts: RelatedPostSummary[];
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} slug={post.id} headings={headings} relatedPosts={relatedPosts}>
	<Content />
</BlogPost>
