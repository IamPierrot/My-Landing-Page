---
import { getCollection } from 'astro:content';
import {
	Shield,
	Network,
	Cpu,
	Server,
	ExternalLink,
	ArrowRight,
	BookOpen,
	MapPin,
	GraduationCap,
	FolderGit2,
	Microscope,
	Terminal,
} from 'lucide-astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import Header from '../components/Header.astro';
import avatarImage from '../assets/avatar.jpg';
import bkiscLogo from '../assets/bkisc-logo.png';
import {
	SITE_DESCRIPTION,
	SITE_TITLE,
	SITE_URL,
	AUTHOR,
	SOCIAL_LINKS,
	FOCUS_AREAS,
	PROJECTS,
} from '../assets/config';
import { buildHomeSchema } from '../utils/seo';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = PROJECTS;
const focusAreas = FOCUS_AREAS;

const siteBase = Astro.site ?? new URL(SITE_URL);
const homeSchema = buildHomeSchema(
	siteBase,
	new URL(Astro.url.pathname, siteBase).href,
	new URL('/og/default.png', siteBase).href,
);

const icons = {
	Microscope,
	Network,
	Cpu,
	Server,
	Shield,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image="/og/default.png"
			imageAlt="Pierrot — Security & Systems Engineering Portfolio"
			schema={homeSchema}
		/>
	</head>
	<body class="bg-[#080D18] text-[#DCE8F5] antialiased">
		<Header />
		<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
			<!-- Hero Section with Avatar -->
			<section class="pb-10 border-b border-[#243752] mb-10" aria-labelledby="hero-title">
				<div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-8">
					<!-- Hero Copy -->
					<div class="flex-1">
						<!-- Terminal Status Badge -->
						<div
							class="inline-flex items-center flex-wrap gap-2 bg-[#101A2B] border border-[#243752] px-3 py-1.5 rounded-md font-mono text-xs sm:text-sm text-[#8FA6C2] mb-4 shadow-sm"
						>
							<span class="text-[#38BDF8] font-bold">$</span>
							<span class="text-[#DCE8F5]">whoami</span>
							<span class="text-[#243752] hidden sm:inline">|</span>
							<div class="inline-flex items-center gap-1.5 text-[#38BDF8] text-xs font-semibold">
								<span class="relative flex h-2 w-2">
									<span
										class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#38BDF8] opacity-75"
									></span>
									<span class="relative inline-flex rounded-full h-2 w-2 bg-[#38BDF8]"></span>
								</span>
								<span>SOC / DFIR / Security Engineering</span>
							</div>
						</div>

						<h1
							id="hero-title"
							class="text-3xl sm:text-5xl font-bold tracking-tight text-[#DCE8F5] mb-4"
						>
							Hi, I'm <span class="text-[#38BDF8] drop-shadow-[0_0_12px_rgba(56,189,248,0.3)]">Pierrot</span>.
						</h1>

						<div>
							<p class="text-base sm:text-lg text-[#8FA6C2] leading-relaxed max-w-2xl mb-5">
								Computer Science student interested in <strong class="text-[#DCE8F5] font-semibold"
									>Blue Team</strong
								>, <strong class="text-[#DCE8F5] font-semibold">DFIR</strong>, <strong
									class="text-[#DCE8F5] font-semibold">network forensics</strong
								>, and <strong class="text-[#DCE8F5] font-semibold">DevSecOps</strong>. I investigate how
								systems and networks behave, document what I learn, and build small tools to make
								technical work more useful.
							</p>

							<!-- Meta badges with icons -->
							<div class="flex items-center flex-wrap gap-x-4 gap-y-2 text-xs font-mono text-[#8FA6C2] mb-6">
								<span class="inline-flex items-center gap-1.5">
									<GraduationCap class="w-4 h-4 text-[#38BDF8]" />
									<span>{AUTHOR.university}</span>
								</span>
								<span class="text-[#243752]">&bull;</span>
								<span class="inline-flex items-center gap-1.5">
									<MapPin class="w-4 h-4 text-[#38BDF8]" />
									<span>{AUTHOR.location}</span>
								</span>
								<span class="text-[#243752]">&bull;</span>
								<a
									href={SOCIAL_LINKS.hackthebox.url}
									target="_blank"
									rel="noreferrer noopener"
									class="inline-flex items-center gap-1.5 text-[#38BDF8] hover:text-[#7DD3FC] transition-colors"
									title="IamPierrot HackTheBox Profile"
								>
									<Terminal class="w-3.5 h-3.5" />
									<span>HTB: {SOCIAL_LINKS.hackthebox.handle}</span>
								</a>
							</div>
						</div>

						<!-- Hero Action Buttons -->
						<div class="flex items-center flex-wrap gap-3">
							<a
								href="/blog"
								class="inline-flex items-center justify-center gap-2 bg-[#38BDF8] text-[#080D18] hover:bg-[#7DD3FC] font-mono text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-md transition-all duration-150 hover:shadow-[0_0_15px_rgba(56,189,248,0.35)] hover:-translate-y-0.5 active:translate-y-0"
							>
								<BookOpen class="w-4 h-4" />
								Read Technical Notes
							</a>

							<a
								href="/projects"
								class="inline-flex items-center justify-center gap-2 bg-[#101A2B] text-[#DCE8F5] border border-[#243752] hover:bg-[#16233B] hover:border-[#38BDF8]/40 hover:text-[#38BDF8] font-mono text-xs sm:text-sm font-medium px-4 py-2.5 rounded-md transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0"
							>
								<FolderGit2 class="w-4 h-4" />
								View Projects
							</a>

							<a
								href="/about"
								class="inline-flex items-center gap-1.5 text-[#8FA6C2] hover:text-[#38BDF8] font-mono text-xs sm:text-sm px-3 py-2.5 transition-colors"
							>
								About Me &rarr;
							</a>
						</div>
					</div>

					<!-- Hero Avatar with Cyber Frame -->
					<div class="shrink-0 self-center md:self-auto relative group">
						<!-- Glow background aura -->
						<div
							class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-[#38BDF8]/30 via-[#60A5FA]/20 to-[#38BDF8]/30 blur-md opacity-70 group-hover:opacity-100 transition duration-300"
						>
						</div>

						<!-- Avatar Card -->
						<div
							class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border-2 border-[#38BDF8]/40 bg-[#101A2B] shadow-[0_0_20px_rgba(56,189,248,0.2)]"
						>
							<Image
								src={avatarImage}
								alt="Pierrot - Nguyen Tan Phat"
								width={176}
								height={176}
								loading="eager"
								fetchpriority="high"
								class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-[#080D18]/80 via-transparent to-transparent pointer-events-none"
							>
							</div>
							<div class="absolute bottom-2 left-2 right-2 text-center">
								<span
									class="inline-flex items-center gap-1 font-mono text-[10px] text-[#38BDF8] bg-[#080D18]/90 px-2 py-0.5 rounded border border-[#38BDF8]/30 backdrop-blur-sm"
								>
									<span class="h-1.5 w-1.5 rounded-full bg-[#38BDF8] animate-pulse"></span>
									DEFENSE_LAB
								</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Technical Focus Areas -->
			<section class="mb-12" aria-labelledby="focus-heading">
				<div class="flex items-center justify-between pb-3 border-b border-[#243752] mb-5">
					<h2
						id="focus-heading"
						class="font-mono text-base font-semibold text-[#DCE8F5] flex items-center gap-2"
					>
						<span class="text-[#38BDF8]">//</span> Technical Focus
					</h2>
					<span class="font-mono text-xs text-[#546C8E] uppercase tracking-wider">Capabilities</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{
						focusAreas.map((area) => {
							const IconComponent = icons[area.iconName];
							return (
								<div class="group bg-[#101A2B] border border-[#243752] rounded-lg p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#38BDF8]/40 hover:bg-[#16233B] hover:shadow-[0_4px_20px_rgba(56,189,248,0.06)] flex flex-col justify-between">
									<div>
										<div class="flex items-center justify-between gap-2 mb-3">
											<div class="flex items-center gap-2.5">
												<div class="w-8 h-8 rounded-md bg-[#16233B] border border-[#243752] flex items-center justify-center text-[#38BDF8] group-hover:border-[#38BDF8]/40 group-hover:bg-[#38BDF8]/10 transition-colors">
													<IconComponent class="w-4 h-4" />
												</div>
												<h3 class="text-base font-semibold text-[#DCE8F5] group-hover:text-[#38BDF8] transition-colors">
													{area.title}
												</h3>
											</div>
											<span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30 font-medium">
												{area.badge}
											</span>
										</div>
										<p class="text-sm text-[#8FA6C2] leading-relaxed">{area.description}</p>
									</div>
									<div class="mt-4 pt-3 border-t border-[#243752]/40 flex items-center justify-between text-xs font-mono text-[#546C8E]">
										<span>MODULE:</span>
										<span class="text-[#8FA6C2]">{area.code}</span>
									</div>
								</div>
							);
						})
					}
				</div>
			</section>

			<!-- Featured Projects -->
			<section class="mb-12" aria-labelledby="projects-heading">
				<div class="flex items-center justify-between pb-3 border-b border-[#243752] mb-5">
					<h2
						id="projects-heading"
						class="font-mono text-base font-semibold text-[#DCE8F5] flex items-center gap-2"
					>
						<span class="text-[#38BDF8]">//</span> Featured Work
					</h2>
					<a
						href="/projects"
						class="font-mono text-xs text-[#8FA6C2] hover:text-[#38BDF8] transition-colors flex items-center gap-1"
					>
						All Projects <ArrowRight class="w-3.5 h-3.5" />
					</a>
				</div>

				<div class="flex flex-col gap-4">
					{
						projects.map((proj) => {
							const ProjIcon = Microscope;
							return (
								<article class="group bg-[#101A2B] border border-[#243752] rounded-lg p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#38BDF8]/40 hover:bg-[#16233B] hover:shadow-[0_4px_20px_rgba(56,189,248,0.06)] flex flex-col gap-3">
									<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
										<div class="flex items-center flex-wrap gap-2.5">
											<div class="w-8 h-8 rounded-md bg-[#16233B] border border-[#243752] flex items-center justify-center text-[#38BDF8] group-hover:border-[#38BDF8]/40 transition-colors">
												<ProjIcon class="w-4 h-4" />
											</div>
											<h3 class="font-mono text-base font-semibold text-[#DCE8F5]">
												{proj.repoUrl ? (
													<a
														href={proj.repoUrl}
														target="_blank"
														rel="noreferrer noopener"
														class="inline-flex items-center gap-1.5 hover:text-[#38BDF8] transition-colors"
													>
														{proj.title}
														<ExternalLink class="w-3.5 h-3.5 opacity-60" />
													</a>
												) : proj.demoUrl ? (
													<a
														href={proj.demoUrl}
														target="_blank"
														rel="noreferrer noopener"
														class="inline-flex items-center gap-1.5 hover:text-[#38BDF8] transition-colors"
													>
														{proj.title}
														<ExternalLink class="w-3.5 h-3.5 opacity-60" />
													</a>
												) : (
													proj.title
												)}
											</h3>
											<span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[#16233B] text-[#60A5FA] border border-[#243752]">
												{proj.category}
											</span>
										</div>
										<span class="font-mono text-xs text-[#8FA6C2] self-start sm:self-auto">
											{proj.status}
										</span>
									</div>

									<p class="text-sm text-[#8FA6C2] leading-relaxed">{proj.description}</p>

									<div class="flex items-center flex-wrap gap-1.5 pt-1">
										{proj.tags.map((tag) => (
											<span class="font-mono text-xs px-2 py-0.5 rounded bg-[#080D18] text-[#546C8E] border border-[#243752]/70">
												{tag}
											</span>
										))}
									</div>
								</article>
							);
						})
					}
				</div>
			</section>

			<!-- Recent Research & Write-ups -->
			<section class="mb-12" aria-labelledby="blog-heading">
				<div class="flex items-center justify-between pb-3 border-b border-[#243752] mb-5">
					<h2
						id="blog-heading"
						class="font-mono text-base font-semibold text-[#DCE8F5] flex items-center gap-2"
					>
						<span class="text-[#38BDF8]">//</span> Recent Research &amp; Write-ups
					</h2>
					<a
						href="/blog"
						class="font-mono text-xs text-[#8FA6C2] hover:text-[#38BDF8] transition-colors flex items-center gap-1"
					>
						View All ({posts.length}) <ArrowRight class="w-3.5 h-3.5" />
					</a>
				</div>

				<div class="flex flex-col gap-4">
					{
						posts.map((post) => (
							<article class="group bg-[#101A2B] border border-[#243752] rounded-lg p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#38BDF8]/40 hover:bg-[#16233B] hover:shadow-[0_4px_20px_rgba(56,189,248,0.06)] flex flex-col gap-3">
								<div class="flex items-center flex-wrap gap-2 text-xs font-mono text-[#8FA6C2]">
									<span class="px-2 py-0.5 rounded bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30 font-medium">
										{post.data.category}
									</span>
									<span class="text-[#243752]">&bull;</span>
									<span>
										<FormattedDate date={post.data.pubDate} />
									</span>
									{post.data.readingTime && (
										<>
											<span class="text-[#243752]">&bull;</span>
											<span class="text-[#546C8E]">{post.data.readingTime}</span>
										</>
									)}
								</div>

								<h3 class="text-lg font-semibold text-[#DCE8F5] leading-snug group-hover:text-[#38BDF8] transition-colors">
									<a href={`/blog/${post.id}/`} class="hover:underline">
										{post.data.title}
									</a>
								</h3>

								<p class="text-sm text-[#8FA6C2] leading-relaxed">{post.data.description}</p>

								<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-[#243752]/40">
									<div class="flex items-center flex-wrap gap-1.5">
										{post.data.tags.map((tag) => (
											<span class="font-mono text-xs px-2 py-0.5 rounded bg-[#080D18] text-[#546C8E] border border-[#243752]/70">
												#{tag}
											</span>
										))}
									</div>
									<a
										href={`/blog/${post.id}/`}
										class="inline-flex items-center gap-1 font-mono text-xs text-[#38BDF8] hover:text-[#7DD3FC] font-medium"
									>
										Read article &rarr;
									</a>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- Lab Affiliation Card (Featuring BKISC Avatar) -->
			<section aria-labelledby="affil-heading">
				<div
					class="bg-gradient-to-r from-[#101A2B] via-[#101A2B] to-[#16233B] border border-[#243752] hover:border-[#38BDF8]/40 rounded-lg p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-sm transition-all duration-200 hover:shadow-[0_4px_24px_rgba(56,189,248,0.08)]"
				>
					<div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 max-w-xl">
						<a
							href={AUTHOR.club.url}
							target="_blank"
							rel="noreferrer noopener"
							class="shrink-0 relative group/avatar block"
							title={`Visit ${AUTHOR.club.name} website`}
						>
							<div
								class="w-14 h-14 sm:w-16 sm:h-16 rounded-full overflow-hidden border-2 border-[#243752] group-hover/avatar:border-[#38BDF8] transition-all duration-200 shadow-md bg-[#080D18]"
							>
								<Image
									src={bkiscLogo}
									alt={`${AUTHOR.club.shortName} Avatar`}
									width={64}
									height={64}
									loading="lazy"
									class="w-full h-full rounded-full object-cover transition-transform duration-200 group-hover/avatar:scale-105"
								/>
							</div>
							<span class="absolute -bottom-0.5 -right-0.5 flex h-3.5 w-3.5">
								<span
									class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#38BDF8] opacity-75"
								></span>
								<span
									class="relative inline-flex rounded-full h-3.5 w-3.5 bg-[#38BDF8] border-2 border-[#101A2B]"
								></span>
							</span>
						</a>

						<div>
							<div
								class="font-mono text-xs text-[#38BDF8] uppercase tracking-wider mb-1 flex items-center gap-1.5"
							>
								<span>University Security Club</span>
								<span class="text-[#243752]">&bull;</span>
								<span class="text-[#8FA6C2]">{AUTHOR.club.role}</span>
							</div>
							<h2 id="affil-heading" class="text-base sm:text-lg font-semibold text-[#DCE8F5] mb-1.5">
								<a
									href={AUTHOR.club.url}
									target="_blank"
									rel="noreferrer noopener"
									class="hover:text-[#38BDF8] transition-colors inline-flex items-center gap-1.5"
								>
									{AUTHOR.club.name}
									<ExternalLink class="w-3.5 h-3.5 opacity-60" />
								</a>
							</h2>
							<p class="text-xs sm:text-sm text-[#8FA6C2] leading-relaxed">
								{AUTHOR.club.description}
							</p>
						</div>
					</div>

					<div class="flex sm:flex-col gap-2 shrink-0 self-stretch sm:self-center">
						<a
							href={AUTHOR.club.url}
							target="_blank"
							rel="noreferrer noopener"
							class="inline-flex items-center justify-center font-mono text-xs font-semibold px-4 py-2 rounded bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30 hover:bg-[#38BDF8]/20 transition-all duration-150"
						>
							Visit {AUTHOR.club.shortName} &rarr;
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
