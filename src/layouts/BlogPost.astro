---
import fs from 'node:fs';
import path from 'node:path';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SidebarContainer from '../components/sidebar/SidebarContainer.astro';
import Sidebar from '../components/sidebar/Sidebar.astro';
import SidebarSection from '../components/sidebar/SidebarSection.astro';
import TableOfContents from '../components/sidebar/TableOfContents.astro';
import ReadingProgress from '../components/sidebar/ReadingProgress.astro';
import MobileSidebar from '../components/sidebar/MobileSidebar.astro';
import { AUTHOR, SITE_URL } from '../consts';
import { buildArticleSchema } from '../utils/seo';
import { Calendar, Tag, Clock, Share2, ArrowLeft, ArrowRight, ArrowUp } from 'lucide-astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface RelatedPost {
	id: string;
	title: string;
	description: string;
	category: string;
	pubDate: Date;
	readingTime?: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	category?: string;
	tags?: string[];
	readingTime?: string;
	headings?: Heading[];
	slug?: string;
	relatedPosts?: RelatedPost[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category = 'Research',
	tags = [],
	readingTime,
	headings = [],
	slug = '',
	relatedPosts = [],
} = Astro.props;

const siteBase = Astro.site ?? new URL(SITE_URL);
const pageUrl = new URL(Astro.url.pathname, siteBase).href;

const slugOgFile = slug ? `blog-${slug}.png` : '';
const hasSlugOgCard =
	slugOgFile.length > 0 &&
	fs.existsSync(path.join(process.cwd(), 'public', 'og', slugOgFile));

const socialImage: ImageMetadata | string = heroImage
	? heroImage
	: hasSlugOgCard
		? `/og/${slugOgFile}`
		: '/og/default.png';

const schemaImageUrl = new URL(
	typeof socialImage === 'string' ? socialImage : socialImage.src,
	siteBase,
).href;

const articleSchema = buildArticleSchema({
	siteUrl: siteBase,
	pageUrl,
	title,
	description,
	imageUrl: schemaImageUrl,
	pubDate,
	updatedDate,
	category,
	tags,
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} // ${AUTHOR.name}`}
			description={description}
			image={socialImage}
			imageAlt={title}
			type="article"
			article={{
				publishedTime: pubDate,
				modifiedTime: updatedDate,
				author: AUTHOR.name,
				section: category,
				tags,
			}}
			schema={articleSchema}
		/>
	</head>

	<body class="bg-[#080D18] text-[#DCE8F5] antialiased selection:bg-[#38BDF8]/20 selection:text-[#38BDF8]">
		<Header />

		<main class="w-full">
			<SidebarContainer maxWidth="max-w-6xl">
				<!-- Mobile TOC & Reading Progress Trigger (< 1024px) -->
				{
					headings.length > 0 && (
						<MobileSidebar slot="mobileSidebar" title="On this page" type="toc">
							<ReadingProgress readingTime={readingTime} />
							<TableOfContents headings={headings} />
						</MobileSidebar>
					)
				}

				<!-- Main Article Content -->
				<article class="w-full max-w-3xl relative">
					<div id="top-sentinel" class="absolute top-0 left-0 w-1 h-[450px] pointer-events-none opacity-0" aria-hidden="true"></div>

					<!-- Top Action & Breadcrumb Navigation -->
					<nav class="flex items-center justify-between gap-4 mb-8 pt-2" aria-label="Breadcrumb">
						<a
							href="/blog"
							class="inline-flex items-center gap-1.5 font-mono text-xs sm:text-sm text-[#8FA6C2] hover:text-[#38BDF8] transition-colors group"
						>
							<ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
							<span>Back to technical journal</span>
						</a>

						<button
							id="share-article-btn"
							type="button"
							class="inline-flex items-center gap-1.5 font-mono text-xs text-[#8FA6C2] hover:text-[#38BDF8] bg-[#101A2B] hover:bg-[#16233B] border border-[#243752] hover:border-[#38BDF8]/40 px-2.5 py-1 rounded transition-all cursor-pointer"
							title="Copy link to article"
							aria-label="Share article"
						>
							<Share2 class="w-3.5 h-3.5 text-[#38BDF8]" />
							<span id="share-btn-text">Share</span>
						</button>
					</nav>

					<!-- Article Header -->
					<header class="pb-8 border-b border-[#243752] mb-10">
						<!-- Metadata Chips -->
						<div class="flex items-center flex-wrap gap-2.5 text-xs font-mono text-[#8FA6C2] mb-4">
							<span class="px-2.5 py-0.5 rounded-full bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30 font-semibold tracking-wide uppercase text-[11px]">
								{category}
							</span>
							<span class="text-[#243752]">&bull;</span>
							<span class="inline-flex items-center gap-1 text-[#8FA6C2]">
								<Calendar class="w-3.5 h-3.5 text-[#38BDF8]" />
								<FormattedDate date={pubDate} />
							</span>
							{readingTime && (
								<>
									<span class="text-[#243752]">&bull;</span>
									<span class="inline-flex items-center gap-1 text-[#546C8E]">
										<Clock class="w-3.5 h-3.5 text-[#546C8E]" />
										{readingTime}
									</span>
								</>
							)}
						</div>

						<!-- Article Headline -->
						<h1 class="text-2xl sm:text-4xl lg:text-[2.5rem] font-bold tracking-tight text-[#F0F6FC] leading-[1.25] mb-5">
							{title}
						</h1>

						<!-- Lead / Abstract Summary -->
						<p class="text-base sm:text-lg text-[#8FA6C2] leading-relaxed mb-6 font-normal">
							{description}
						</p>

						<!-- Updated Date notice if present -->
						{updatedDate && (
							<div class="font-mono text-xs text-[#546C8E] mb-4 flex items-center gap-1.5">
								<span>Last updated:</span>
								<FormattedDate date={updatedDate} />
							</div>
						)}

						<!-- Tags Cloud -->
						{tags.length > 0 && (
							<div class="flex items-center flex-wrap gap-1.5 pt-1">
								{tags.map((tag) => (
									<span class="font-mono text-xs px-2 py-0.5 rounded bg-[#101A2B] text-[#7DD3FC] border border-[#38BDF8]/20 hover:border-[#38BDF8]/50 transition-colors">
										#{tag}
									</span>
								))}
							</div>
						)}
					</header>

					<!-- Optional Hero Image -->
					{heroImage && (
						<div class="mb-10">
							<Image
								width={960}
								height={480}
								src={heroImage}
								alt={title}
								class="w-full h-auto rounded-lg border border-[#243752] shadow-xl shadow-black/40"
							/>
						</div>
					)}

					<!-- Markdown / Prose Body -->
					<div class="prose max-w-none" id="article-prose">
						<slot />
					</div>

					<!-- Related Articles (Internal Linking) -->
					{relatedPosts.length > 0 && (
						<section class="mt-14 pt-8 border-t border-[#243752]" aria-labelledby="related-notes-heading">
							<div class="flex items-center justify-between mb-4">
								<h2 id="related-notes-heading" class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8FA6C2] flex items-center gap-2">
									<span class="text-[#38BDF8]">//</span>
									<span>Related Technical Notes</span>
								</h2>
								<a href="/blog" class="font-mono text-xs text-[#38BDF8] hover:underline">
									View all &rarr;
								</a>
							</div>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								{relatedPosts.map((rel) => (
									<a
										href={`/blog/${rel.id}/`}
										class="group bg-[#101A2B] border border-[#243752] hover:border-[#38BDF8]/50 hover:bg-[#142035] rounded-lg p-4 flex flex-col justify-between gap-2.5 transition-all"
									>
										<div>
											<div class="flex items-center justify-between gap-2 font-mono text-[11px] text-[#8FA6C2] mb-1.5">
												<span class="text-[#38BDF8] font-medium">{rel.category}</span>
												<FormattedDate date={rel.pubDate} />
											</div>
											<h3 class="text-sm font-semibold text-[#F0F6FC] group-hover:text-[#38BDF8] transition-colors line-clamp-2 mb-1">
												{rel.title}
											</h3>
											<p class="text-xs text-[#8FA6C2] line-clamp-2 leading-relaxed">
												{rel.description}
											</p>
										</div>
										<div class="flex items-center justify-between font-mono text-[11px] text-[#38BDF8] pt-1">
											<span>{rel.readingTime || 'Technical Note'}</span>
											<ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
										</div>
									</a>
								))}
							</div>
						</section>
					)}

					<!-- Article Footer Actions -->
					<footer class="mt-14 pt-8 border-t border-[#243752] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<a
							href="/blog"
							class="inline-flex items-center justify-center gap-2 font-mono text-xs font-medium px-4 py-2.5 rounded bg-[#101A2B] text-[#DCE8F5] border border-[#243752] hover:bg-[#16233B] hover:border-[#38BDF8]/40 hover:text-[#38BDF8] transition-all"
						>
							<ArrowLeft class="w-3.5 h-3.5" />
							<span>All articles</span>
						</a>

						<div class="flex items-center gap-3">
							<button
								type="button"
								class="footer-copy-url inline-flex items-center gap-1.5 font-mono text-xs px-3 py-2 rounded bg-[#101A2B] text-[#8FA6C2] border border-[#243752] hover:text-[#38BDF8] hover:border-[#38BDF8]/40 transition-colors cursor-pointer"
								title="Copy article link"
							>
								<Share2 class="w-3.5 h-3.5 text-[#38BDF8]" />
								<span>Share article</span>
							</button>

							<a
								href="https://github.com/IamPierrot"
								target="_blank"
								rel="noreferrer noopener"
								class="inline-flex items-center gap-1 font-mono text-xs text-[#8FA6C2] hover:text-[#38BDF8] transition-colors"
							>
								Suggest edit on GitHub &rarr;
							</a>
						</div>
					</footer>
				</article>

				<!-- Desktop Right Sidebar (Sticky >= 1024px) -->
				<Sidebar slot="sidebar" ariaLabel="Article sidebar" position="right">
					<!-- Reading Progress Widget -->
					<ReadingProgress readingTime={readingTime} />

					<!-- Table of Contents -->
					{headings.length > 0 && <TableOfContents headings={headings} />}

					<!-- Article Quick Metadata -->
					<SidebarSection title="DOCUMENT INFO">
						<div class="flex flex-col gap-2.5 text-xs font-mono text-[#8FA6C2] bg-[#101A2B]/70 border border-[#243752] rounded-lg p-3.5">
							<div class="flex items-center justify-between">
								<span class="text-[#546C8E] flex items-center gap-1">
									<Calendar class="w-3.5 h-3.5 text-[#38BDF8]" /> Published:
								</span>
								<span class="text-[#DCE8F5]">
									<FormattedDate date={pubDate} />
								</span>
							</div>

							<div class="flex items-center justify-between">
								<span class="text-[#546C8E]">Category:</span>
								<span class="text-[#38BDF8] font-medium">{category}</span>
							</div>

							<div class="flex items-center justify-between">
								<span class="text-[#546C8E]">Affiliation:</span>
								<span class="text-[#DCE8F5]">HCMUT CSE</span>
							</div>

							{tags.length > 0 && (
								<div class="pt-2.5 border-t border-[#243752]/60 flex flex-col gap-1.5">
									<span class="text-[#546C8E] flex items-center gap-1 text-[11px]">
										<Tag class="w-3 h-3 text-[#38BDF8]" /> TAGS:
									</span>
									<div class="flex flex-wrap gap-1">
										{tags.map((t) => (
											<span class="text-[10px] px-1.5 py-0.5 rounded bg-[#080D18] text-[#8FA6C2] border border-[#243752]">
												#{t}
											</span>
										))}
									</div>
								</div>
							)}
						</div>
					</SidebarSection>
				</Sidebar>
			</SidebarContainer>
		</main>

		<!-- Floating Back to Top Button -->
		<button
			id="floating-back-to-top"
			type="button"
			aria-label="Scroll back to top"
			class="fixed bottom-6 right-6 z-40 p-3 rounded-full bg-[#101A2B] border border-[#243752] text-[#8FA6C2] hover:text-[#38BDF8] hover:border-[#38BDF8]/60 hover:bg-[#16233B] shadow-xl shadow-black/50 opacity-0 pointer-events-none transition-all duration-300 cursor-pointer"
		>
			<ArrowUp class="w-4 h-4" />
		</button>

		<Footer />

		<!-- Client-Side Readability & Ergonomics Enhancements -->
		<script>
			import { initMermaidDiagrams } from '../scripts/mermaid';

			async function initArticleEnhancements() {
				const prose = document.getElementById('article-prose');
				if (!prose) return;

				// 1. Initialize interactive Mermaid diagrams (Section 1 & 4 of TASKS_2)
				await initMermaidDiagrams();

				// 2. Wrap raw tables in responsive .table-wrapper
				const tables = prose.querySelectorAll('table');
				tables.forEach((table) => {
					if (table.parentElement && !table.parentElement.classList.contains('table-wrapper')) {
						const wrapper = document.createElement('div');
						wrapper.className = 'table-wrapper';
						table.parentNode?.insertBefore(wrapper, table);
						wrapper.appendChild(table);
					}
				});

				// 3. Enhance code blocks with terminal header & copy-to-clipboard action
				const codeBlocks = prose.querySelectorAll<HTMLPreElement>('pre');
				codeBlocks.forEach((pre) => {
					if (pre.parentElement && pre.parentElement.classList.contains('code-block-wrapper')) {
						return;
					}

					// Skip mermaid blocks (handled exclusively by Mermaid renderer)
					let lang = pre.getAttribute('data-language') || '';
					if (lang === 'mermaid' || pre.classList.contains('mermaid') || pre.hasAttribute('data-mermaid-processed')) {
						return;
					}

					if (!lang || lang === 'plaintext') {
						const codeEl = pre.querySelector('code');
						const classList = codeEl ? Array.from(codeEl.classList) : [];
						const langClass = classList.find((c) => c.startsWith('language-'));
						if (langClass) {
							lang = langClass.replace('language-', '');
						} else {
							lang = 'terminal';
						}
					}

					if (lang === 'mermaid') {
						return;
					}

					// Create wrapper
					const wrapper = document.createElement('div');
					wrapper.className = 'code-block-wrapper';

					// Create header bar
					const header = document.createElement('div');
					header.className = 'code-block-header';

					const langBadge = document.createElement('span');
					langBadge.className = 'code-block-lang';
					langBadge.textContent = lang;

					const copyBtn = document.createElement('button');
					copyBtn.className = 'code-copy-btn';
					copyBtn.type = 'button';
					copyBtn.innerHTML = `
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
						<span>Copy</span>
					`;

					copyBtn.addEventListener('click', async () => {
						const textToCopy = pre.innerText.trim();
						try {
							await navigator.clipboard.writeText(textToCopy);
							copyBtn.classList.add('copied');
							copyBtn.innerHTML = `
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
								<span>Copied!</span>
							`;
							setTimeout(() => {
								copyBtn.classList.remove('copied');
								copyBtn.innerHTML = `
									<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
									<span>Copy</span>
								`;
							}, 2000);
						} catch {
							copyBtn.textContent = 'Failed';
						}
					});

					header.appendChild(langBadge);
					header.appendChild(copyBtn);

					pre.parentNode?.insertBefore(wrapper, pre);
					wrapper.appendChild(header);
					wrapper.appendChild(pre);
				});

				// 3. Share URL handling
				const shareButtons = document.querySelectorAll<HTMLButtonElement>('#share-article-btn, .footer-copy-url');
				shareButtons.forEach((btn) => {
					btn.addEventListener('click', async () => {
						try {
							await navigator.clipboard.writeText(window.location.href);
							const textSpan = btn.querySelector('span');
							if (textSpan) {
								const original = textSpan.textContent;
								textSpan.textContent = 'Copied!';
								btn.classList.add('text-[#38BDF8]', 'border-[#38BDF8]/60');
								setTimeout(() => {
									textSpan.textContent = original;
									btn.classList.remove('text-[#38BDF8]', 'border-[#38BDF8]/60');
								}, 2000);
							}
						} catch (e) {
							console.error('Failed to copy URL', e);
						}
					});
				});

				// 4. Floating Back to Top Button (IntersectionObserver sentinel - zero scroll event listener overhead)
				const backToTopBtn = document.getElementById('floating-back-to-top');
				const sentinel = document.getElementById('top-sentinel');
				if (backToTopBtn && sentinel) {
					const observer = new IntersectionObserver(
						(entries) => {
							const isAtTop = entries[0].isIntersecting;
							if (isAtTop) {
								backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
								backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
							} else {
								backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
								backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
							}
						},
						{ threshold: 0 }
					);
					observer.observe(sentinel);

					backToTopBtn.addEventListener('click', () => {
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
				}
			}

			// Initialize on DOMContentLoaded and on view transitions if any
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initArticleEnhancements);
			} else {
				initArticleEnhancements();
			}
			document.addEventListener('astro:page-load', initArticleEnhancements);
		</script>
	</body>
</html>
